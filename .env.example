# Trade Assistant settings. Copy this file to .env and fill in what you have.
# Never commit .env or share it: it holds your brokerage data token.

# --- Market data -------------------------------------------------------------
# With a live token you get real-time quotes and Greeks (market data only: this
# app has no code that places orders). With only a sandbox token quotes are 15
# minutes late, which is fine for research and backtests but not for setting a
# limit price. With neither, the app runs on made-up demo data.
TRADIER_LIVE_TOKEN=
TRADIER_SANDBOX_TOKEN=

# auto picks live, then sandbox, then demo. Or force one: live | sandbox | demo | robinhood
DATA_MODE=auto

# --- Robinhood data (optional) ---------------------------------------------------
# To take quotes, option chains and Greeks from your own Robinhood account:
#   1. run:  python run.py --robinhood-check      (signs you in and tests every call)
#   2. if every step says OK, set DATA_MODE=robinhood above and start the app
# The app only reads. It cannot place, change or cancel orders, and it reads your
# holdings and past orders only if you set ROBINHOOD_ACCOUNT_READ=1 below (never
# balances). The sign-in itself is stored in
# data/robinhood_signin.json and may permit more than the app uses, so never share
# that file. Keep a Tradier token above if you have one: it is used for long price
# history when Robinhood's does not reach far enough.
# Seconds between live quote updates on the pricing screen (1 or more).
ROBINHOOD_POLL_SECONDS=3
# Port on this computer that the browser sign-in returns to. Change it only if
# the check says the port is in use, then run the check again.
ROBINHOOD_CALLBACK_PORT=8421
# 2.6: also read your filled orders and holdings through the Robinhood connection, for the My trades
# screen. Off unless set to 1. Reads only, and only tools named get_equity/stock/option _positions or
# _orders; balances, account numbers, bank links and every tool that acts are refused by name.
# Robinhood's connection may list share orders only; the account activity report (Reports and
# statements > Account activity report, a CSV you import on My trades) has your option trades too.
# ROBINHOOD_ACCOUNT_READ=0

# --- Your account and limits --------------------------------------------------
# Set ACCOUNT_SIZE to the money you trade options with. The limits below are
# percentages of it, enforced on every trade ticket.
ACCOUNT_SIZE=10000
# Most premium one idea (all tickets in one stock) may put at risk.
MAX_RISK_PER_TRADE_PCT=2
# Most premium at risk across all open positions and saved plans.
MAX_OPEN_RISK_PCT=10
# Stop opening new trades for the day after losing this much.
DAILY_LOSS_STOP_PCT=3
# What counts toward that stop: REALIZED_PLUS_UNREALIZED (closed trades and today's change in
# open positions, the safer choice) or REALIZED_ONLY (closed trades only).
DAILY_LOSS_MODE=REALIZED_PLUS_UNREALIZED
# When today's loss cannot be fully measured (a position has no current price or no previous
# close): WARN says so on the trade ticket and never calls it "inside all of your limits";
# BLOCK also makes it a limit the ticket breaks, which you can override on purpose.
INCOMPLETE_RISK_POLICY=WARN
# Refuse contracts whose bid-ask spread is wider than this share of the midpoint.
MAX_SPREAD_PCT=10
# Refuse options with fewer days than this to expiration.
MIN_DTE=7

# --- How old a price may be (optional) ------------------------------------------
# While the market is open, a quote older than this many seconds is shown as stale. A delayed
# source (the Tradier sandbox) is allowed 20 minutes. When the market is closed, the latest
# session's price is shown as such, not as stale.
# FRESHNESS_STOCK_QUOTE_SECONDS=120
# FRESHNESS_OPTION_QUOTE_SECONDS=300
# FRESHNESS_INDEX_QUOTE_SECONDS=300

# --- SEC filings (optional) ----------------------------------------------------
# The SEC requires automated requests to name the caller and give a contact
# address, for example: Jane Trader jane@example.com
# Leave empty to switch filings and the earnings-date estimate off.
SEC_USER_AGENT=

# --- News (optional) -------------------------------------------------------------
# Company and market headlines come from Finnhub. A free key is at https://finnhub.io
# (free accounts are limited to about 60 requests a minute). Without it the news screens
# show SEC filings only.
FINNHUB_API_KEY=

# --- Live news (optional, 2.10) ------------------------------------------------------
# The Live news screen listens for stock-moving news and checks the price after each item.
# It uses every source that is set up: SEC 8-K filings (SEC_USER_AGENT above), Finnhub
# headlines (FINNHUB_API_KEY above) and RTPR press releases. RTPR (https://rtpr.io) streams
# Business Wire, PR Newswire, GlobeNewswire and AccessWire releases within about a second
# on its paid plan (the free plan is five minutes late). In RTPR's dashboard, create the
# "All articles" rule (or a rule for your stocks): the stream sends what your rules match.
RTPR_API_KEY=
# Which stocks are traded: large (the ~330 large stocks, your watchlist and holdings) or
# all (any ticker at $5 or more trading at least $20 million a day).
# LIVE_UNIVERSE=large
# A move counts when, since the news, it is at least this percent and this many of the
# stock's daily ranges (and the day's move points the same way).
# LIVE_MIN_REACTION_PCT=1.0
# LIVE_MIN_REACTION_ATR=0.3
# When the news reached the app two minutes or more after it was published, the day's move
# must be at least this many daily ranges and this percent instead.
# LIVE_MIN_DAY_ATR=1.5
# LIVE_MIN_DAY_PCT=3.0
# Email each new opportunity, and each move against a stock you hold (needs SMTP below; at
# most 20 a day).
# LIVE_NEWS_EMAIL=0
# Start listening when the app starts (it also resumes if it was on when the app stopped).
# LIVE_NEWS_AUTOSTART=0

# --- AI briefs (optional) ----------------------------------------------------------
# With an Anthropic API key, Claude writes market and stock briefs from the app's own
# numbers and the headlines, reads headline tone, and reads trade descriptions the rules
# cannot. Requests are billed by Anthropic to your API account (https://console.anthropic.com),
# separately from any Claude subscription. Without a key everything else still works.
# What is sent: tickers, prices, indicators, option figures and headlines. Never sent:
# your keys, account size, positions or journal.
ANTHROPIC_API_KEY=
# The model to use (an Anthropic API model name).
AI_MODEL=claude-sonnet-5-5
# Let the model search the web for the latest news (1) or use only the app's data (0).
# Web searches are billed per search on top of tokens.
AI_WEB_SEARCH=1
# At most this many AI requests a day (0 switches AI off). Cached answers do not count.
AI_DAILY_REQUESTS=40

# --- The morning email (2.8, optional) --------------------------------------------
# Every market morning at 7:00 (your computer's own time zone), the app can email you the morning plan:
# the big movers with a setup, the reversal triggers to watch, and each trade's limit price. Set it up
# once with ./setup_morning.sh (macOS; the script prints the cron line for Linux). Try it first with:
#   .venv/bin/python run.py --morning-print
# With Gmail: SMTP_USER is your address and SMTP_PASSWORD an app password from
# myaccount.google.com/apppasswords (2-Step Verification must be on; changing your Google password
# revokes app passwords). Any other provider works through SMTP_HOST/SMTP_PORT (STARTTLS).
# The password stays in this file on this computer and never appears in logs or replies.
SMTP_USER=
SMTP_PASSWORD=
# Where the plan goes; SMTP_USER itself when empty.
EMAIL_TO=
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# The limit-price cap: reaching target 1 must pay at least this many times what the stop loses (1.0 =
# the gain at target 1 at least equals the loss at the stop; 1.5 is stricter and lowers the cap).
# MORNING_MIN_PAYOFF=1.0

# --- Other ---------------------------------------------------------------------
# Symbols used by default in the pattern lab, backtests and the daily snapshot.
WATCHLIST=AAPL,MSFT,GOOGL,AMZN,NVDA,META,TSLA,BRK.B,JPM,JNJ,V,PG,MA,HD,CVX,MRK,ABBV,PEP,KO,COST
# Interest rate used in option pricing (0.04 = 4%). Small effect on short-dated options.
RISK_FREE_RATE=0.04
# Trading cost per side for stock studies and backtests, in basis points (5 = 0.05%).
STOCK_COST_BPS=5
# Where the database lives. Demo data always goes to a separate ".demo" file.
TRADEASSIST_DB=data/tradeassist.db

# --- Version 2 features ----------------------------------------------------------
# Each can be switched off with 0 (or back on with 1) without affecting the rest.
# FEATURE_UNIFIED_POSITIONS=1
# FEATURE_TREND_ENGINE_V2=1
# FEATURE_PORTFOLIO_RISK=1
# FEATURE_SIGNAL_CALIBRATION=1
# FEATURE_REVERSAL_ANALYSIS=1
# 2.4
# FEATURE_OPTIONS_LAB=1
# FEATURE_SCANNER=1
# FEATURE_STRATEGY_BUILDER=1
# FEATURE_MARKET_NEWS=1
# FEATURE_AI_ASSISTANT=1
# 2.5: the Today screen (it also needs FEATURE_TREND_ENGINE_V2)
# FEATURE_TODAY=1
# 2.6: the My trades screen (your imported Robinhood history)
# FEATURE_TRADE_HISTORY=1
# 2.7: the Trade ideas screen (a scan of up to 200 large companies, and a simulation of any trade)
# FEATURE_TRADE_IDEAS=1
# 2.8: the Morning plan screen and email (movers, setups, reversal triggers, trade cards)
# FEATURE_MORNING=1
# 2.10: the Live news screen (news as it arrives, the price's answer, a card when it confirms)
# FEATURE_LIVE_NEWS=1
# Option backtests need historical option prices, which no connected source provides.
# FEATURE_OPTIONS_BACKTEST=0
